  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT
  Employees.Id
  ,Employees.FirstName
  ,Employees.LastName
  ,Employees.Email
  ,Employees.Department
  ,Employees.[Position]
  ,Employees.HireDate
FROM
  Tasks
  INNER JOIN Employees
    ON Tasks.EmployeeId = Employees.Id
  INNER JOIN Projects
    ON Tasks.ProjectId = Projects.Id</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <AutoJoin>False</AutoJoin>
            <SelectedColumns>
              <ColumnExpression ColumnOwner="Employees" ColumnName="Id" />
              <ColumnExpression ColumnOwner="Employees" ColumnName="FirstName" />
              <ColumnExpression ColumnOwner="Employees" ColumnName="LastName" />
              <ColumnExpression ColumnOwner="Employees" ColumnName="Email" />
              <ColumnExpression ColumnOwner="Employees" ColumnName="Department" />
              <ColumnExpression ColumnOwner="Employees" ColumnName="Position" />
              <ColumnExpression ColumnOwner="Employees" ColumnName="HireDate" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="Tasks" />
              <Join Type="INNER JOIN" ColumnOwner="Employees">
                <On>
                  <From ColumnOwner="Tasks" ColumnName="EmployeeId" />
                  <To ColumnOwner="Employees" ColumnName="Id" />
                </On>
              </Join>
              <Join Type="INNER JOIN" ColumnOwner="Projects">
                <On>
                  <From ColumnOwner="Tasks" ColumnName="ProjectId" />
                  <To ColumnOwner="Projects" ColumnName="Id" />
                </On>
              </Join>
            </Joins>
          </QueryDefinition>
        </rd:DesignerState>
      </Query>
